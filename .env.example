# SoundAccess — example environment configuration.
# Copy to `.env` and replace values. NEVER commit the real `.env`.

# HMAC signing key for JWT access tokens (generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))")
SOUNDACCESS_JWT_SECRET=CHANGE_ME_generate_a_random_64_byte_secret

# JWT settings
SOUNDACCESS_JWT_ISSUER=https://auth.soundaccess.local
SOUNDACCESS_JWT_AUDIENCE=https://api.soundaccess.local
SOUNDACCESS_ACCESS_TOKEN_MINUTES=15

# Authorization code lifetime (seconds)
SOUNDACCESS_AUTH_CODE_SECONDS=60

# Database
SOUNDACCESS_DATABASE_URL=sqlite:///./soundaccess.db

# Comma-separated allowed CORS origins (demo only)
SOUNDACCESS_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Password used when seeding demo users (development only)
SOUNDACCESS_SEED_USER_PASSWORD=CHANGE_ME_demo_password
# Client secret assigned to the seeded service client (development only)
SOUNDACCESS_SEED_SERVICE_SECRET=CHANGE_ME_service_secret

# Admin registration key required by POST /oauth/clients
SOUNDACCESS_CLIENT_REGISTRATION_KEY=CHANGE_ME_registration_key
